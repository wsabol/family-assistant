<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.family-assistant.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>REPLACE_WITH_PROJECT/dist/cli/index.js</string>
    <string>digest</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PROJECT</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PROJECT/data/logs/launchd-digest.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PROJECT/data/logs/launchd-digest.err.log</string>
</dict>
</plist>
