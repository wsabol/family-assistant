# Required
DATABASE_PATH=./data/family-assistant.db
FAMILY_CONFIG_PATH=./config/family.json
LOG_LEVEL=info
LOG_DIR=./data/logs

# Google OAuth (shared client; separate token files)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./data/tokens/gmail.json
GOOGLE_CALENDAR_TOKEN_PATH=./data/tokens/calendar.json

# AI extraction (OpenAI)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional tuning
REVIEW_PORT=3847
WATCH_BATCH_LIMIT=20
WORK_BATCH_LIMIT=5
CALENDAR_BATCH_LIMIT=10
STALE_PROCESSING_MINUTES=30
BODY_MAX_CHARS=12000
DIGEST_DIR=./data/digests
OAUTH_REDIRECT_PORT=3456
